# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Google AI Studio — server only (set in Vercel, never NEXT_PUBLIC_)
GEMINI_API_KEY=

# --- LLM providers (all optional; the app tries them in order and falls back to built-in content) ---
# Google AI Studio (Gemini)
# GROQ_API_KEY=            console.groq.com (first in the chain: fast and cheap)
# GROQ_MODEL=openai/gpt-oss-120b   optional override; the default is a current Groq production model
# OPENROUTER_API_KEY=      openrouter.ai
# OPENROUTER_MODEL=openai/gpt-oss-120b   optional override (any model id from openrouter.ai/models)
# CF_ACCOUNT_ID= / CF_API_TOKEN=   Cloudflare Workers AI (free daily allowance)
# CF_MODEL=@cf/meta/llama-3.1-8b-instruct
# LLM_MODE=rotate          rotate (default: spread load) or primary (Groq first, then the rest in order)

# --- Movie titles (server only) ---
# TMDB (themoviedb.org → Settings → API). The read access token is preferred; the v3 key also works.
# Without either, movie themes use AI-only puzzles and the weekly top-up is skipped.
# TMDB_READ_TOKEN=
# TMDB_API_KEY=
# Share of Chor Kaun topics made from movie titles in the weekly top-up (0–1, default 0.33).
# CHOR_MOVIE_SHARE=

# --- Analytics and admin (server only, never NEXT_PUBLIC_) ---
# Supabase → Project Settings → API → service_role key. Bypasses row-level security: keep it secret.
# SUPABASE_SERVICE_ROLE_KEY=
#
# Admin panel: off unless all of these are set. Generate with: node scripts/admin-setup.mjs
# ADMIN_PATH=               secret URL segment, 24+ characters (the panel lives at /<ADMIN_PATH>)
# ADMIN_USERNAME=
# ADMIN_PASSWORD_HASH=      scrypt$... from: node scripts/admin-setup.mjs password "<password>"
# ADMIN_TOTP_SECRET=        from: node scripts/admin-setup.mjs totp
# ADMIN_SESSION_SECRET=     from: node scripts/admin-setup.mjs session

